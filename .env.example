NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Stripe sandbox only. Prefer a restricted rk_test_ key with Checkout Session
# read/write permissions. Never prefix either secret with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Dedicated Cal.com service-booking event type.
CAL_EVENT_TYPE_ID=your_event_type_id
CAL_EVENT_DURATION_MINUTES=60

# Canonical deployed origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Resend transactional email. Verify the sender domain in Resend first.
RESEND_API_KEY=re_your_server_only_api_key
RESEND_FROM_EMAIL=Hibiscus Group <bookings@your-domain.example>
COMPANY_NOTIFICATION_EMAIL=bookings@your-domain.example
